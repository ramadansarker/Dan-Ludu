rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isValidStringList(listVal, maxLen) {
      return listVal is list
        && listVal.size() >= 1
        && listVal.size() <= maxLen
        && listVal[0] is string
        && listVal[0].size() <= 64;
    }

    function isValidUserSave(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'coins', 'diamonds', 'level', 'xp',
          'wins', 'gamesPlayed', 'selectedTheme', 'selectedToken',
          'selectedDice', 'selectedAvatar', 'unlockedThemes',
          'unlockedTokens', 'unlockedDice', 'unlockedAvatars',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'coins', 'diamonds', 'level', 'xp',
          'wins', 'gamesPlayed', 'selectedTheme', 'selectedToken',
          'selectedDice', 'selectedAvatar', 'unlockedThemes',
          'unlockedTokens', 'unlockedDice', 'unlockedAvatars',
          'dailyClaimedAt', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
        && data.coins is int && data.coins >= 0 && data.coins <= 10000000
        && data.diamonds is int && data.diamonds >= 0 && data.diamonds <= 1000000
        && data.level is int && data.level >= 1 && data.level <= 500
        && data.xp is int && data.xp >= 0 && data.xp <= 10000000
        && data.wins is int && data.wins >= 0 && data.wins <= 1000000
        && data.gamesPlayed is int && data.gamesPlayed >= 0 && data.gamesPlayed <= 1000000
        && data.selectedTheme is string && data.selectedTheme.size() >= 1 && data.selectedTheme.size() <= 32
        && data.selectedToken is string && data.selectedToken.size() >= 1 && data.selectedToken.size() <= 32
        && data.selectedDice is string && data.selectedDice.size() >= 1 && data.selectedDice.size() <= 32
        && data.selectedAvatar is string && data.selectedAvatar.size() >= 1 && data.selectedAvatar.size() <= 64
        && isValidStringList(data.unlockedThemes, 30)
        && isValidStringList(data.unlockedTokens, 30)
        && isValidStringList(data.unlockedDice, 30)
        && isValidStringList(data.unlockedAvatars, 30)
        && (!('dailyClaimedAt' in data) || (data.dailyClaimedAt is string && data.dailyClaimedAt.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFriendProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'avatarId', 'level', 'wins', 'isPublic', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'avatarId', 'level', 'wins', 'isPublic', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
        && data.avatarId is string && data.avatarId.size() >= 1 && data.avatarId.size() <= 64
        && data.level is int && data.level >= 1 && data.level <= 500
        && data.wins is int && data.wins >= 0 && data.wins <= 1000000
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransferCode(data) {
      return data.keys().hasAll([
          'ownerUid', 'displayName', 'coins', 'diamonds', 'level', 'wins',
          'selectedTheme', 'selectedToken', 'selectedDice', 'selectedAvatar', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'displayName', 'coins', 'diamonds', 'level', 'wins',
          'selectedTheme', 'selectedToken', 'selectedDice', 'selectedAvatar', 'createdAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
        && data.coins is int && data.coins >= 0 && data.coins <= 10000000
        && data.diamonds is int && data.diamonds >= 0 && data.diamonds <= 1000000
        && data.level is int && data.level >= 1 && data.level <= 500
        && data.wins is int && data.wins >= 0 && data.wins <= 1000000
        && data.selectedTheme is string && data.selectedTheme.size() >= 1 && data.selectedTheme.size() <= 32
        && data.selectedToken is string && data.selectedToken.size() >= 1 && data.selectedToken.size() <= 32
        && data.selectedDice is string && data.selectedDice.size() >= 1 && data.selectedDice.size() <= 32
        && data.selectedAvatar is string && data.selectedAvatar.size() >= 1 && data.selectedAvatar.size() <= 64
        && data.createdAt is timestamp;
    }

    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if isVerifiedOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserSave(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserSave(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'coins', 'diamonds', 'level', 'xp', 'wins', 'gamesPlayed',
          'selectedTheme', 'selectedToken', 'selectedDice', 'selectedAvatar',
          'unlockedThemes', 'unlockedTokens', 'unlockedDice', 'unlockedAvatars',
          'dailyClaimedAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /friendProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.isPublic == true;
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidFriendProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidFriendProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'avatarId', 'level', 'wins', 'isPublic', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /transferCodes/{code} {
      allow get: if isSignedIn() && isValidId(code) && code.size() >= 6 && code.size() <= 16;
      allow list: if false;
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && isValidId(code)
        && code.size() >= 6 && code.size() <= 16
        && isValidTransferCode(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && existing().ownerUid == request.auth.uid;
    }
  }
}
